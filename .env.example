# Copy to .env for local runs. Never commit the real .env file.
# Pipeline credentials (SONAR_*, DOCKERHUB_*, NVIDIA_*) belong in GitHub repository secrets.

APP_SECRET_KEY=change-me
FLASK_PORT=5000

# Remediation agent (only needed to run scripts/remediate_agent.py locally)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Health monitor
MONITOR_URL=http://localhost:5000/health
ALERT_WEBHOOK_URL=
